{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["react", "node"],
    "moduleSuffixes": [".native", ""],
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "ios", "android"]
}
