{
  "name": "kleio",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "node scripts/runtime.mjs start",
    "build": "tsc -p tsconfig.runtime.json --noEmit",
    "setup:dsh": "npm install --prefix packages/harness-dsh/.runtime --ignore-scripts --save-exact @deepseek-ai/dsh@0.2.1-alpha.2",
    "setup:native": "pnpm setup:dsh",
    "start": "node scripts/runtime.mjs start",
    "web": "node scripts/runtime.mjs web",
    "web:build": "pnpm --filter @kleio/mobile build:web",
    "cloud:start": "node scripts/cloud-web.mjs",
    "stop": "node scripts/runtime.mjs stop",
    "test": "node scripts/verify-native.mjs",
    "test:runtime": "node --import tsx --test packages/core/test/*.test.ts packages/runtime/*.test.ts packages/harness-dsh/test/*.test.ts packages/connectors/*.test.ts apps/mobile/src/*.test.mjs",
    "native:verify": "node scripts/verify-native.mjs",
    "test:memory": "node --test packages/personal-memory/store.test.mjs packages/personal-memory/files.test.mjs packages/personal-memory/application.test.mjs packages/personal-memory/capture.test.mjs",
    "test:ui": "node --test packages/personal-agent-ui/api.test.mjs",
    "typecheck": "tsc -p tsconfig.runtime.json --noEmit",
    "verify:application": "node scripts/verify-personal-application.mjs",
    "verify:capture": "node --env-file-if-exists=.env scripts/verify-memory-capture-provider.mjs",
    "verify:plugin": "node scripts/verify-personal-agent-plugin.mjs",
    "test:tasks": "node scripts/verify-personal-tasks.mjs",
    "verify:tasks": "node scripts/verify-personal-tasks-native.mjs",
    "verify:provider": "node scripts/verify-deepseek.mjs",
    "verify:memory-provider": "node scripts/verify-memory-provider.mjs",
    "verify:l1-live": "node --import tsx scripts/verify-l1-live-model.ts --confirm-live-model",
    "verify": "pnpm native:verify",
    "native:dev": "node scripts/native-web.mjs",
    "native:start": "node scripts/native-web.mjs",
    "native:stop": "node scripts/native-stop.mjs",
    "native:build": "node packages/personal-agent-ui/build.mjs && node scripts/verify-native.mjs --quick",
    "native:typecheck": "tsc -p packages/personal-agent-ui/tsconfig.json --noEmit",
    "chat": "node scripts/runtime.mjs chat",
    "kleio": "node scripts/runtime.mjs",
    "mobile": "node scripts/runtime.mjs mobile",
    "mobile:dev": "pnpm --filter @kleio/mobile start",
    "mobile:ios": "pnpm --filter @kleio/mobile ios",
    "mobile:build:ios": "pnpm --filter @kleio/mobile build:ios",
    "mobile:typecheck": "pnpm --filter @kleio/mobile typecheck"
  },
  "dependencies": {
    "@hono/node-server": "2.1.4",
    "croner": "10.0.1",
    "hono": "4.13.13",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.20.0",
    "typescript": "5.9.2"
  }
}
