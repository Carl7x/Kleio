# Native DeepSeek Harness Web. Copy to .env; keep the real key local.
KLEIO_PORT=4317
KLEIO_MODEL_BASE_URL=https://api.deepseek.com
KLEIO_MODEL_ID=deepseek-flash
KLEIO_MODEL_API_KEY=replace-with-your-key
# Optional separate native data directory. It contains sessions and application data.
# KLEIO_DSH_HOME=.data/dsh-native
# Optional existing directory for delegated-task files.
# KLEIO_TASK_WORKSPACE=D:/Your Workspace
# Optional HTTPS origin when using a reverse proxy; native auth remains enabled.
# KLEIO_PUBLIC_URL=https://agent.example.com/
