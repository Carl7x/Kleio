# Optional process environment for the headless runtime.
# Prefer owner-only ~/.config/kleio/config.json for persistent local settings.
# This file is an example; the runtime does not auto-load repository .env files.
KLEIO_PORT=4317
KLEIO_MODEL_BASE_URL=https://api.deepseek.com
KLEIO_MODEL_ID=deepseek-flash
KLEIO_MODEL_API_KEY=replace-with-your-key
# KLEIO_DATA_DIR=/absolute/path/outside/source/kleio
# KLEIO_CONFIG=/absolute/path/outside/source/config.json
# KLEIO_NODE_BINARY=/absolute/path/to/node
